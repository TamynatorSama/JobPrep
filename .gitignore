backend/.cache/
# Latency/token harness output (machine-specific timings + sidecar logs).
backend/bench/results/
# Stray run artifacts (some are already tracked — untrack with `git rm --cached`).
.td.*.log
backend/_boot_err.txt
backend/test_outputs/
backend/.claude/

